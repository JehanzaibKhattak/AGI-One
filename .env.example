# Copy to .env.local. Generate a secret with: openssl rand -base64 32
DATABASE_URL=postgresql://agi_dev@127.0.0.1:55439/agi_one
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional Microsoft 365 connection. See docs/microsoft-365.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
# Generate separately with: openssl rand -base64 32. Keep stable and back it up securely.
CONNECTION_ENCRYPTION_KEY=
